# Copier en .env.local pour le développement — jamais commité.
# En production, ces valeurs se posent sur Vercel :
#   vercel env add RESEND_API_KEY production
# (la CLI demande la valeur sans l’écrire dans un fichier ni dans l’historique)

# ─── Envoi du formulaire de contact, via Resend (https://resend.com) ───
# Sans RESEND_API_KEY ni CONTACT_TO_EMAIL, l’API répond 503 « unconfigured »
# et le formulaire invite poliment à écrire par email. Rien ne casse.

# Clé API Resend — commence par « re_ ». À créer dans Resend > API Keys,
# en permission « Sending access » : elle ne peut qu’envoyer, rien lire.
RESEND_API_KEY=

# Adresse qui reçoit les messages du formulaire.
CONTACT_TO_EMAIL=

# Expéditeur affiché.
#  - Sans domaine vérifié : garder onboarding@resend.dev. Resend n’autorise
#    alors l’envoi QUE vers l’adresse du compte Resend lui-même — donc
#    CONTACT_TO_EMAIL doit être cette adresse.
#  - Avec maelbelhacene.com vérifié dans Resend : passer à
#    "Mael Belhacene <contact@maelbelhacene.com>", meilleure délivrabilité
#    et expéditeur crédible.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# ─── Domaine public (métadonnées, sitemap, Open Graph) ───
# Facultatif : src/lib/site.ts retombe déjà sur https://maelbelhacene.com.
NEXT_PUBLIC_SITE_URL=https://maelbelhacene.com
